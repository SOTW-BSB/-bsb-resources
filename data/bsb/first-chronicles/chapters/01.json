{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "1CH",
  "chapter": 1,
  "verses": [
    {
      "id": "1CH.1.1",
      "edition_verse_id": "BSB:1CH.1.1",
      "verse": 1,
      "spans": [
        {
          "text": "Adam, Seth, Enosh,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "1CH.1.2",
      "edition_verse_id": "BSB:1CH.1.2",
      "verse": 2,
      "spans": [
        {
          "text": "Kenan, Mahalalel, Jared,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "1CH.1.3",
      "edition_verse_id": "BSB:1CH.1.3",
      "verse": 3,
      "spans": [
        {
          "text": "Enoch, Methuselah, Lamech, Noah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "1CH.1.4",
      "edition_verse_id": "BSB:1CH.1.4",
      "verse": 4,
      "spans": [
        {
          "text": "The sons of Noah: Shem, Ham, and Japheth.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "1CH.1.5",
      "edition_verse_id": "BSB:1CH.1.5",
      "verse": 5,
      "spans": [
        {
          "text": "The sons of Japheth: Gomer, Magog, Madai, Javan, Tubal, Meshech, and Tiras.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.6",
      "edition_verse_id": "BSB:1CH.1.6",
      "verse": 6,
      "spans": [
        {
          "text": "The sons of Gomer: Ashkenaz, Riphath, and Togarmah.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.7",
      "edition_verse_id": "BSB:1CH.1.7",
      "verse": 7,
      "spans": [
        {
          "text": "And the sons of Javan: Elishah, Tarshish, the Kittites, and the Rodanites.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.8",
      "edition_verse_id": "BSB:1CH.1.8",
      "verse": 8,
      "spans": [
        {
          "text": "The sons of Ham: Cush, Mizraim, Put, and Canaan.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.9",
      "edition_verse_id": "BSB:1CH.1.9",
      "verse": 9,
      "spans": [
        {
          "text": "The sons of Cush: Seba, Havilah, Sabta, Raamah, and Sabteca. The sons of Raamah: Sheba and Dedan.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.10",
      "edition_verse_id": "BSB:1CH.1.10",
      "verse": 10,
      "spans": [
        {
          "text": "Cush was the father of Nimrod, who began to be a mighty one on the earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.11",
      "edition_verse_id": "BSB:1CH.1.11",
      "verse": 11,
      "spans": [
        {
          "text": "Mizraim was the father of the Ludites, the Anamites, the Lehabites, the Naphtuhites,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.12",
      "edition_verse_id": "BSB:1CH.1.12",
      "verse": 12,
      "spans": [
        {
          "text": "the Pathrusites, the Casluhites (from whom the Philistines came), and the Caphtorites.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.13",
      "edition_verse_id": "BSB:1CH.1.13",
      "verse": 13,
      "spans": [
        {
          "text": "And Canaan was the father of Sidon his firstborn, and of the Hittites,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.14",
      "edition_verse_id": "BSB:1CH.1.14",
      "verse": 14,
      "spans": [
        {
          "text": "the Jebusites, the Amorites, the Girgashites,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.15",
      "edition_verse_id": "BSB:1CH.1.15",
      "verse": 15,
      "spans": [
        {
          "text": "the Hivites, the Arkites, the Sinites,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.16",
      "edition_verse_id": "BSB:1CH.1.16",
      "verse": 16,
      "spans": [
        {
          "text": "the Arvadites, the Zemarites, and the Hamathites.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.17",
      "edition_verse_id": "BSB:1CH.1.17",
      "verse": 17,
      "spans": [
        {
          "text": "The sons of Shem: Elam, Asshur, Arphaxad, Lud, and Aram. The sons of Aram: Uz, Hul, Gether, and Meshech.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.18",
      "edition_verse_id": "BSB:1CH.1.18",
      "verse": 18,
      "spans": [
        {
          "text": "Arphaxad was the father of Shelah, and Shelah was the father of Eber.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.19",
      "edition_verse_id": "BSB:1CH.1.19",
      "verse": 19,
      "spans": [
        {
          "text": "Two sons were born to Eber: One was named Peleg, because in his days the earth was divided, and his brother was named Joktan.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.20",
      "edition_verse_id": "BSB:1CH.1.20",
      "verse": 20,
      "spans": [
        {
          "text": "And Joktan was the father of Almodad, Sheleph, Hazarmaveth, Jerah,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.21",
      "edition_verse_id": "BSB:1CH.1.21",
      "verse": 21,
      "spans": [
        {
          "text": "Hadoram, Uzal, Diklah,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.22",
      "edition_verse_id": "BSB:1CH.1.22",
      "verse": 22,
      "spans": [
        {
          "text": "Obal, Abimael, Sheba,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.23",
      "edition_verse_id": "BSB:1CH.1.23",
      "verse": 23,
      "spans": [
        {
          "text": "Ophir, Havilah, and Jobab. All these were sons of Joktan.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.24",
      "edition_verse_id": "BSB:1CH.1.24",
      "verse": 24,
      "spans": [
        {
          "text": "So from Shem came Arphaxad, Shelah,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.25",
      "edition_verse_id": "BSB:1CH.1.25",
      "verse": 25,
      "spans": [
        {
          "text": "Eber, Peleg, Reu,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.26",
      "edition_verse_id": "BSB:1CH.1.26",
      "verse": 26,
      "spans": [
        {
          "text": "Serug, Nahor, Terah,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.27",
      "edition_verse_id": "BSB:1CH.1.27",
      "verse": 27,
      "spans": [
        {
          "text": "and Abram (that is, Abraham).",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.28",
      "edition_verse_id": "BSB:1CH.1.28",
      "verse": 28,
      "spans": [
        {
          "text": "The sons of Abraham were Isaac and Ishmael.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "1CH.1.29",
      "edition_verse_id": "BSB:1CH.1.29",
      "verse": 29,
      "spans": [
        {
          "text": "These are their genealogies: Nebaioth the firstborn of Ishmael, then Kedar, Adbeel, Mibsam,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.30",
      "edition_verse_id": "BSB:1CH.1.30",
      "verse": 30,
      "spans": [
        {
          "text": "Mishma, Dumah, Massa, Hadad, Tema,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.31",
      "edition_verse_id": "BSB:1CH.1.31",
      "verse": 31,
      "spans": [
        {
          "text": "Jetur, Naphish, and Kedemah. These were the sons of Ishmael.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.32",
      "edition_verse_id": "BSB:1CH.1.32",
      "verse": 32,
      "spans": [
        {
          "text": "The sons born to Keturah, Abraham’s concubine: Zimran, Jokshan, Medan, Midian, Ishbak, and Shuah. The sons of Jokshan: Sheba and Dedan.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.33",
      "edition_verse_id": "BSB:1CH.1.33",
      "verse": 33,
      "spans": [
        {
          "text": "The sons of Midian: Ephah, Epher, Hanoch, Abida, and Eldaah. All of these were Keturah’s sons.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.34",
      "edition_verse_id": "BSB:1CH.1.34",
      "verse": 34,
      "spans": [
        {
          "text": "Abraham was the father of Isaac. The sons of Isaac: Esau and Israel.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.35",
      "edition_verse_id": "BSB:1CH.1.35",
      "verse": 35,
      "spans": [
        {
          "text": "The sons of Esau: Eliphaz, Reuel, Jeush, Jalam, and Korah.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.36",
      "edition_verse_id": "BSB:1CH.1.36",
      "verse": 36,
      "spans": [
        {
          "text": "The sons of Eliphaz: Teman, Omar, Zepho, Gatam, and Kenaz; and by Timna, Amalek.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.37",
      "edition_verse_id": "BSB:1CH.1.37",
      "verse": 37,
      "spans": [
        {
          "text": "The sons of Reuel: Nahath, Zerah, Shammah, and Mizzah.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.38",
      "edition_verse_id": "BSB:1CH.1.38",
      "verse": 38,
      "spans": [
        {
          "text": "The sons of Seir: Lotan, Shobal, Zibeon, Anah, Dishon, Ezer, and Dishan.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.39",
      "edition_verse_id": "BSB:1CH.1.39",
      "verse": 39,
      "spans": [
        {
          "text": "The sons of Lotan: Hori and Homam. Timna was Lotan’s sister.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.40",
      "edition_verse_id": "BSB:1CH.1.40",
      "verse": 40,
      "spans": [
        {
          "text": "The sons of Shobal: Alvan, Manahath, Ebal, Shepho, and Onam. The sons of Zibeon: Aiah and Anah.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.41",
      "edition_verse_id": "BSB:1CH.1.41",
      "verse": 41,
      "spans": [
        {
          "text": "The son of Anah: Dishon. The sons of Dishon: Hemdan, Eshban, Ithran, and Cheran.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.42",
      "edition_verse_id": "BSB:1CH.1.42",
      "verse": 42,
      "spans": [
        {
          "text": "The sons of Ezer: Bilhan, Zaavan, and Akan. The sons of Dishan: Uz and Aran.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.43",
      "edition_verse_id": "BSB:1CH.1.43",
      "verse": 43,
      "spans": [
        {
          "text": "These are the kings who reigned in the land of Edom before any king reigned over the Israelites: Bela son of Beor. His city was named Dinhabah.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "1CH.1.44",
      "edition_verse_id": "BSB:1CH.1.44",
      "verse": 44,
      "spans": [
        {
          "text": "When Bela died, Jobab son of Zerah from Bozrah reigned in his place.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.45",
      "edition_verse_id": "BSB:1CH.1.45",
      "verse": 45,
      "spans": [
        {
          "text": "When Jobab died, Husham from the land of the Temanites reigned in his place.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.46",
      "edition_verse_id": "BSB:1CH.1.46",
      "verse": 46,
      "spans": [
        {
          "text": "When Husham died, Hadad son of Bedad, who defeated Midian in the country of Moab, reigned in his place. And the name of his city was Avith.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.47",
      "edition_verse_id": "BSB:1CH.1.47",
      "verse": 47,
      "spans": [
        {
          "text": "When Hadad died, Samlah from Masrekah reigned in his place.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.48",
      "edition_verse_id": "BSB:1CH.1.48",
      "verse": 48,
      "spans": [
        {
          "text": "When Samlah died, Shaul from Rehoboth on the Euphrates reigned in his place.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.49",
      "edition_verse_id": "BSB:1CH.1.49",
      "verse": 49,
      "spans": [
        {
          "text": "When Shaul died, Baal-hanan son of Achbor reigned in his place.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.50",
      "edition_verse_id": "BSB:1CH.1.50",
      "verse": 50,
      "spans": [
        {
          "text": "When Baal-hanan died, Hadad reigned in his place. His city was named Pau, and his wife’s name was Mehetabel daughter of Matred, the daughter of Me-zahab.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.51",
      "edition_verse_id": "BSB:1CH.1.51",
      "verse": 51,
      "spans": [
        {
          "text": "Then Hadad died. Now the chiefs of Edom were Timna, Alvah, Jetheth,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.52",
      "edition_verse_id": "BSB:1CH.1.52",
      "verse": 52,
      "spans": [
        {
          "text": "Oholibamah, Elah, Pinon,",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "1CH.1.53",
      "edition_verse_id": "BSB:1CH.1.53",
      "verse": 53,
      "spans": [
        {
          "text": "Kenaz, Teman, Mibzar,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "1CH.1.54",
      "edition_verse_id": "BSB:1CH.1.54",
      "verse": 54,
      "spans": [
        {
          "text": "Magdiel, and Iram. These were the chiefs of Edom.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
