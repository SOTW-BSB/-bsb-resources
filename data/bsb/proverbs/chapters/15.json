{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PRO",
  "chapter": 15,
  "verses": [
    {
      "id": "PRO.15.1",
      "edition_verse_id": "BSB:PRO.15.1",
      "verse": 1,
      "spans": [
        {
          "text": "A gentle answer turns away wrath, but a harsh word stirs up anger.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.15.2",
      "edition_verse_id": "BSB:PRO.15.2",
      "verse": 2,
      "spans": [
        {
          "text": "The tongue of the wise commends knowledge, but the mouth of the fool spouts folly.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.3",
      "edition_verse_id": "BSB:PRO.15.3",
      "verse": 3,
      "spans": [
        {
          "text": "The eyes of the LORD are in every place, observing the evil and the good.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.4",
      "edition_verse_id": "BSB:PRO.15.4",
      "verse": 4,
      "spans": [
        {
          "text": "A soothing tongue is a tree of life, but a perverse tongue crushes the spirit.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.5",
      "edition_verse_id": "BSB:PRO.15.5",
      "verse": 5,
      "spans": [
        {
          "text": "A fool rejects his father’s discipline, but whoever heeds correction is prudent.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.6",
      "edition_verse_id": "BSB:PRO.15.6",
      "verse": 6,
      "spans": [
        {
          "text": "The house of the righteous has great treasure, but the income of the wicked is trouble.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.7",
      "edition_verse_id": "BSB:PRO.15.7",
      "verse": 7,
      "spans": [
        {
          "text": "The lips of the wise spread knowledge, but not so the hearts of fools.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.8",
      "edition_verse_id": "BSB:PRO.15.8",
      "verse": 8,
      "spans": [
        {
          "text": "The sacrifice of the wicked is detestable to the LORD, but the prayer of the upright is His delight.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.9",
      "edition_verse_id": "BSB:PRO.15.9",
      "verse": 9,
      "spans": [
        {
          "text": "The LORD detests the way of the wicked, but He loves those who pursue righteousness.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.10",
      "edition_verse_id": "BSB:PRO.15.10",
      "verse": 10,
      "spans": [
        {
          "text": "Discipline is harsh for him who leaves the path; he who hates correction will die.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.11",
      "edition_verse_id": "BSB:PRO.15.11",
      "verse": 11,
      "spans": [
        {
          "text": "Sheol and Abaddon lie open before the LORD— how much more the hearts of men!",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.12",
      "edition_verse_id": "BSB:PRO.15.12",
      "verse": 12,
      "spans": [
        {
          "text": "A mocker does not love to be reproved, nor will he consult the wise.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.13",
      "edition_verse_id": "BSB:PRO.15.13",
      "verse": 13,
      "spans": [
        {
          "text": "A joyful heart makes a cheerful countenance, but sorrow of the heart crushes the spirit.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.14",
      "edition_verse_id": "BSB:PRO.15.14",
      "verse": 14,
      "spans": [
        {
          "text": "A discerning heart seeks knowledge, but the mouth of a fool feeds on folly.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.15",
      "edition_verse_id": "BSB:PRO.15.15",
      "verse": 15,
      "spans": [
        {
          "text": "All the days of the oppressed are bad, but a cheerful heart has a continual feast.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.16",
      "edition_verse_id": "BSB:PRO.15.16",
      "verse": 16,
      "spans": [
        {
          "text": "Better a little with the fear of the LORD than great treasure with turmoil.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.17",
      "edition_verse_id": "BSB:PRO.15.17",
      "verse": 17,
      "spans": [
        {
          "text": "Better a dish of vegetables where there is love than a fattened ox with hatred.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.18",
      "edition_verse_id": "BSB:PRO.15.18",
      "verse": 18,
      "spans": [
        {
          "text": "A hot-tempered man stirs up strife, but he who is slow to anger calms dispute.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.19",
      "edition_verse_id": "BSB:PRO.15.19",
      "verse": 19,
      "spans": [
        {
          "text": "The way of the slacker is like a hedge of thorns, but the path of the upright is a highway.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.20",
      "edition_verse_id": "BSB:PRO.15.20",
      "verse": 20,
      "spans": [
        {
          "text": "A wise son brings joy to his father, but a foolish man despises his mother.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.21",
      "edition_verse_id": "BSB:PRO.15.21",
      "verse": 21,
      "spans": [
        {
          "text": "Folly is joy to one who lacks judgment, but a man of understanding walks a straight path.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.22",
      "edition_verse_id": "BSB:PRO.15.22",
      "verse": 22,
      "spans": [
        {
          "text": "Plans fail for lack of counsel, but with many advisers they succeed.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.23",
      "edition_verse_id": "BSB:PRO.15.23",
      "verse": 23,
      "spans": [
        {
          "text": "A man takes joy in a fitting reply — and how good is a timely word!",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.24",
      "edition_verse_id": "BSB:PRO.15.24",
      "verse": 24,
      "spans": [
        {
          "text": "The path of life leads upward for the wise, that he may avoid going down to Sheol.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.25",
      "edition_verse_id": "BSB:PRO.15.25",
      "verse": 25,
      "spans": [
        {
          "text": "The LORD tears down the house of the proud, but He protects the boundaries of the widow.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.26",
      "edition_verse_id": "BSB:PRO.15.26",
      "verse": 26,
      "spans": [
        {
          "text": "The LORD detests the thoughts of the wicked, but the words of the pure are pleasant to Him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.27",
      "edition_verse_id": "BSB:PRO.15.27",
      "verse": 27,
      "spans": [
        {
          "text": "He who is greedy for unjust gain brings trouble on his household, but he who hates bribes will live.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.28",
      "edition_verse_id": "BSB:PRO.15.28",
      "verse": 28,
      "spans": [
        {
          "text": "The heart of the righteous ponders how to answer, but the mouth of the wicked blurts out evil.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.29",
      "edition_verse_id": "BSB:PRO.15.29",
      "verse": 29,
      "spans": [
        {
          "text": "The LORD is far from the wicked, but He hears the prayer of the righteous.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.30",
      "edition_verse_id": "BSB:PRO.15.30",
      "verse": 30,
      "spans": [
        {
          "text": "The light of the eyes cheers the heart, and good news nourishes the bones.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.31",
      "edition_verse_id": "BSB:PRO.15.31",
      "verse": 31,
      "spans": [
        {
          "text": "He who listens to life-giving reproof will dwell among the wise.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.32",
      "edition_verse_id": "BSB:PRO.15.32",
      "verse": 32,
      "spans": [
        {
          "text": "He who ignores discipline despises himself, but whoever heeds correction gains understanding.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.15.33",
      "edition_verse_id": "BSB:PRO.15.33",
      "verse": 33,
      "spans": [
        {
          "text": "The fear of the LORD is the instruction of wisdom, and humility comes before honor.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
