{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PRO",
  "chapter": 13,
  "verses": [
    {
      "id": "PRO.13.1",
      "edition_verse_id": "BSB:PRO.13.1",
      "verse": 1,
      "spans": [
        {
          "text": "A wise son heeds his father’s discipline, but a mocker does not listen to rebuke.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PRO.13.2",
      "edition_verse_id": "BSB:PRO.13.2",
      "verse": 2,
      "spans": [
        {
          "text": "From the fruit of his lips a man enjoys good things, but the desire of the faithless is violence.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.3",
      "edition_verse_id": "BSB:PRO.13.3",
      "verse": 3,
      "spans": [
        {
          "text": "He who guards his mouth protects his life, but the one who opens his lips invites his own ruin.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.4",
      "edition_verse_id": "BSB:PRO.13.4",
      "verse": 4,
      "spans": [
        {
          "text": "The slacker craves yet has nothing, but the soul of the diligent is fully satisfied.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.5",
      "edition_verse_id": "BSB:PRO.13.5",
      "verse": 5,
      "spans": [
        {
          "text": "The righteous hate falsehood, but the wicked bring shame and disgrace.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.6",
      "edition_verse_id": "BSB:PRO.13.6",
      "verse": 6,
      "spans": [
        {
          "text": "Righteousness guards the man of integrity, but wickedness undermines the sinner.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.7",
      "edition_verse_id": "BSB:PRO.13.7",
      "verse": 7,
      "spans": [
        {
          "text": "One pretends to be rich, but has nothing; another pretends to be poor, yet has great wealth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.8",
      "edition_verse_id": "BSB:PRO.13.8",
      "verse": 8,
      "spans": [
        {
          "text": "Riches may ransom a man’s life, but a poor man hears no threat.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.9",
      "edition_verse_id": "BSB:PRO.13.9",
      "verse": 9,
      "spans": [
        {
          "text": "The light of the righteous shines brightly, but the lamp of the wicked is extinguished.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.10",
      "edition_verse_id": "BSB:PRO.13.10",
      "verse": 10,
      "spans": [
        {
          "text": "Arrogance leads only to strife, but wisdom is with the well-advised.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.11",
      "edition_verse_id": "BSB:PRO.13.11",
      "verse": 11,
      "spans": [
        {
          "text": "Dishonest wealth will dwindle, but what is earned through hard work will be multiplied.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.12",
      "edition_verse_id": "BSB:PRO.13.12",
      "verse": 12,
      "spans": [
        {
          "text": "Hope deferred makes the heart sick, but desire fulfilled is a tree of life.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.13",
      "edition_verse_id": "BSB:PRO.13.13",
      "verse": 13,
      "spans": [
        {
          "text": "He who despises instruction will pay the penalty, but the one who respects a command will be rewarded.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.14",
      "edition_verse_id": "BSB:PRO.13.14",
      "verse": 14,
      "spans": [
        {
          "text": "The teaching of the wise is a fountain of life, turning one from the snares of death.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.15",
      "edition_verse_id": "BSB:PRO.13.15",
      "verse": 15,
      "spans": [
        {
          "text": "Good understanding wins favor, but the way of the faithless is difficult.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.16",
      "edition_verse_id": "BSB:PRO.13.16",
      "verse": 16,
      "spans": [
        {
          "text": "Every prudent man acts with knowledge, but a fool displays his folly.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.17",
      "edition_verse_id": "BSB:PRO.13.17",
      "verse": 17,
      "spans": [
        {
          "text": "A wicked messenger falls into trouble, but a faithful envoy brings healing.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.18",
      "edition_verse_id": "BSB:PRO.13.18",
      "verse": 18,
      "spans": [
        {
          "text": "Poverty and shame come to him who ignores discipline, but whoever heeds correction is honored.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.19",
      "edition_verse_id": "BSB:PRO.13.19",
      "verse": 19,
      "spans": [
        {
          "text": "Desire fulfilled is sweet to the soul, but turning from evil is detestable to fools.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.20",
      "edition_verse_id": "BSB:PRO.13.20",
      "verse": 20,
      "spans": [
        {
          "text": "He who walks with the wise will become wise, but the companion of fools will be destroyed.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.21",
      "edition_verse_id": "BSB:PRO.13.21",
      "verse": 21,
      "spans": [
        {
          "text": "Disaster pursues sinners, but prosperity is the reward of the righteous.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.22",
      "edition_verse_id": "BSB:PRO.13.22",
      "verse": 22,
      "spans": [
        {
          "text": "A good man leaves an inheritance to his children’s children, but the sinner’s wealth is passed to the righteous.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.23",
      "edition_verse_id": "BSB:PRO.13.23",
      "verse": 23,
      "spans": [
        {
          "text": "Abundant food is in the fallow ground of the poor, but without justice it is swept away.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.24",
      "edition_verse_id": "BSB:PRO.13.24",
      "verse": 24,
      "spans": [
        {
          "text": "He who spares the rod hates his son, but he who loves him disciplines him diligently.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PRO.13.25",
      "edition_verse_id": "BSB:PRO.13.25",
      "verse": 25,
      "spans": [
        {
          "text": "A righteous man eats to his heart’s content, but the stomach of the wicked is empty.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
