{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 61,
  "verses": [
    {
      "id": "PSA.61.1",
      "edition_verse_id": "BSB:PSA.61.1",
      "verse": 1,
      "spans": [
        {
          "text": "For the choirmaster. With stringed instruments. Of David. Hear my cry, O God; attend to my prayer.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.61.2",
      "edition_verse_id": "BSB:PSA.61.2",
      "verse": 2,
      "spans": [
        {
          "text": "From the ends of the earth I call out to You whenever my heart is faint. Lead me to the rock that is higher than I.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.61.3",
      "edition_verse_id": "BSB:PSA.61.3",
      "verse": 3,
      "spans": [
        {
          "text": "For You have been my refuge, a tower of strength against the enemy.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.61.4",
      "edition_verse_id": "BSB:PSA.61.4",
      "verse": 4,
      "spans": [
        {
          "text": "Let me dwell in Your tent forever and take refuge in the shelter of Your wings. Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.61.5",
      "edition_verse_id": "BSB:PSA.61.5",
      "verse": 5,
      "spans": [
        {
          "text": "For You have heard my vows, O God; You have given me the inheritance reserved for those who fear Your name.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.61.6",
      "edition_verse_id": "BSB:PSA.61.6",
      "verse": 6,
      "spans": [
        {
          "text": "Increase the days of the king’s life; may his years span many generations.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.61.7",
      "edition_verse_id": "BSB:PSA.61.7",
      "verse": 7,
      "spans": [
        {
          "text": "May he sit enthroned in God’s presence forever; appoint Your loving devotion and Your faithfulness to guard him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.61.8",
      "edition_verse_id": "BSB:PSA.61.8",
      "verse": 8,
      "spans": [
        {
          "text": "Then I will ever sing praise to Your name and fulfill my vows day by day.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
