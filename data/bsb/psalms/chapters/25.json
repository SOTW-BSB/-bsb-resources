{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 25,
  "verses": [
    {
      "id": "PSA.25.1",
      "edition_verse_id": "BSB:PSA.25.1",
      "verse": 1,
      "spans": [
        {
          "text": "Of David. To You, O LORD, I lift up my soul;",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.25.2",
      "edition_verse_id": "BSB:PSA.25.2",
      "verse": 2,
      "spans": [
        {
          "text": "in You, my God, I trust. Do not let me be put to shame; do not let my enemies exult over me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.3",
      "edition_verse_id": "BSB:PSA.25.3",
      "verse": 3,
      "spans": [
        {
          "text": "Surely none who wait for You will be put to shame; but those who engage in treachery without cause will be disgraced.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.4",
      "edition_verse_id": "BSB:PSA.25.4",
      "verse": 4,
      "spans": [
        {
          "text": "Show me Your ways, O LORD; teach me Your paths.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.5",
      "edition_verse_id": "BSB:PSA.25.5",
      "verse": 5,
      "spans": [
        {
          "text": "Guide me in Your truth and teach me, for You are the God of my salvation; all day long I wait for You.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.6",
      "edition_verse_id": "BSB:PSA.25.6",
      "verse": 6,
      "spans": [
        {
          "text": "Remember, O LORD, Your compassion and loving devotion, for they are from age to age.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.7",
      "edition_verse_id": "BSB:PSA.25.7",
      "verse": 7,
      "spans": [
        {
          "text": "Remember not the sins of my youth, nor my rebellious acts; remember me according to Your loving devotion, because of Your goodness, O LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.8",
      "edition_verse_id": "BSB:PSA.25.8",
      "verse": 8,
      "spans": [
        {
          "text": "Good and upright is the LORD; therefore He shows sinners the way.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.9",
      "edition_verse_id": "BSB:PSA.25.9",
      "verse": 9,
      "spans": [
        {
          "text": "He guides the humble in what is right and teaches them His way.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.10",
      "edition_verse_id": "BSB:PSA.25.10",
      "verse": 10,
      "spans": [
        {
          "text": "All the LORD’s ways are loving and faithful to those who keep His covenant and His decrees.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.11",
      "edition_verse_id": "BSB:PSA.25.11",
      "verse": 11,
      "spans": [
        {
          "text": "For the sake of Your name, O LORD, forgive my iniquity, for it is great.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.12",
      "edition_verse_id": "BSB:PSA.25.12",
      "verse": 12,
      "spans": [
        {
          "text": "Who is the man who fears the LORD? He will instruct him in the path chosen for him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.13",
      "edition_verse_id": "BSB:PSA.25.13",
      "verse": 13,
      "spans": [
        {
          "text": "His soul will dwell in prosperity, and his descendants will inherit the land.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.14",
      "edition_verse_id": "BSB:PSA.25.14",
      "verse": 14,
      "spans": [
        {
          "text": "The LORD confides in those who fear Him, and reveals His covenant to them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.15",
      "edition_verse_id": "BSB:PSA.25.15",
      "verse": 15,
      "spans": [
        {
          "text": "My eyes are always on the LORD, for He will free my feet from the mesh.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.16",
      "edition_verse_id": "BSB:PSA.25.16",
      "verse": 16,
      "spans": [
        {
          "text": "Turn to me and be gracious, for I am lonely and afflicted.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.17",
      "edition_verse_id": "BSB:PSA.25.17",
      "verse": 17,
      "spans": [
        {
          "text": "The troubles of my heart increase; free me from my distress.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.18",
      "edition_verse_id": "BSB:PSA.25.18",
      "verse": 18,
      "spans": [
        {
          "text": "Consider my affliction and trouble, and take away all my sins.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.19",
      "edition_verse_id": "BSB:PSA.25.19",
      "verse": 19,
      "spans": [
        {
          "text": "Consider my enemies, for they are many, and they hate me with vicious hatred.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.20",
      "edition_verse_id": "BSB:PSA.25.20",
      "verse": 20,
      "spans": [
        {
          "text": "Guard my soul and deliver me; let me not be put to shame, for I take refuge in You.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.21",
      "edition_verse_id": "BSB:PSA.25.21",
      "verse": 21,
      "spans": [
        {
          "text": "May integrity and uprightness preserve me, because I wait for You.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.25.22",
      "edition_verse_id": "BSB:PSA.25.22",
      "verse": 22,
      "spans": [
        {
          "text": "Redeem Israel, O God, from all its distress.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
