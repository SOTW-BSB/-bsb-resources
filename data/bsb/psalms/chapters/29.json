{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 29,
  "verses": [
    {
      "id": "PSA.29.1",
      "edition_verse_id": "BSB:PSA.29.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Psalm of David. Ascribe to the LORD, O heavenly beings, ascribe to the LORD glory and strength.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.29.2",
      "edition_verse_id": "BSB:PSA.29.2",
      "verse": 2,
      "spans": [
        {
          "text": "Ascribe to the LORD the glory due His name; worship the LORD in the splendor of His holiness.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.3",
      "edition_verse_id": "BSB:PSA.29.3",
      "verse": 3,
      "spans": [
        {
          "text": "The voice of the LORD is over the waters; the God of glory thunders; the LORD is heard over many waters.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.4",
      "edition_verse_id": "BSB:PSA.29.4",
      "verse": 4,
      "spans": [
        {
          "text": "The voice of the LORD is powerful; the voice of the LORD is majestic.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.5",
      "edition_verse_id": "BSB:PSA.29.5",
      "verse": 5,
      "spans": [
        {
          "text": "The voice of the LORD breaks the cedars; the LORD shatters the cedars of Lebanon.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.6",
      "edition_verse_id": "BSB:PSA.29.6",
      "verse": 6,
      "spans": [
        {
          "text": "He makes Lebanon skip like a calf, and Sirion like a young wild ox.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.7",
      "edition_verse_id": "BSB:PSA.29.7",
      "verse": 7,
      "spans": [
        {
          "text": "The voice of the LORD strikes with flames of fire.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.8",
      "edition_verse_id": "BSB:PSA.29.8",
      "verse": 8,
      "spans": [
        {
          "text": "The voice of the LORD shakes the wilderness; the LORD shakes the Wilderness of Kadesh.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.9",
      "edition_verse_id": "BSB:PSA.29.9",
      "verse": 9,
      "spans": [
        {
          "text": "The voice of the LORD twists the oaks and strips the forests bare. And in His temple all cry, “Glory!”",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.10",
      "edition_verse_id": "BSB:PSA.29.10",
      "verse": 10,
      "spans": [
        {
          "text": "The LORD sits enthroned over the flood; the LORD is enthroned as King forever.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.29.11",
      "edition_verse_id": "BSB:PSA.29.11",
      "verse": 11,
      "spans": [
        {
          "text": "The LORD gives His people strength; the LORD blesses His people with peace.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
