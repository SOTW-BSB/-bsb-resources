{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 145,
  "verses": [
    {
      "id": "PSA.145.1",
      "edition_verse_id": "BSB:PSA.145.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Psalm of praise. Of David. I will exalt You, my God and King; I will bless Your name forever and ever.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.145.2",
      "edition_verse_id": "BSB:PSA.145.2",
      "verse": 2,
      "spans": [
        {
          "text": "Every day I will bless You, and I will praise Your name forever and ever.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.3",
      "edition_verse_id": "BSB:PSA.145.3",
      "verse": 3,
      "spans": [
        {
          "text": "Great is the LORD and greatly to be praised; His greatness is unsearchable.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.4",
      "edition_verse_id": "BSB:PSA.145.4",
      "verse": 4,
      "spans": [
        {
          "text": "One generation will commend Your works to the next, and will proclaim Your mighty acts—",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.5",
      "edition_verse_id": "BSB:PSA.145.5",
      "verse": 5,
      "spans": [
        {
          "text": "the glorious splendor of Your majesty. And I will meditate on Your wondrous works.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.6",
      "edition_verse_id": "BSB:PSA.145.6",
      "verse": 6,
      "spans": [
        {
          "text": "They will proclaim the power of Your awesome deeds, and I will declare Your greatness.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.7",
      "edition_verse_id": "BSB:PSA.145.7",
      "verse": 7,
      "spans": [
        {
          "text": "They will extol the fame of Your abundant goodness and sing joyfully of Your righteousness.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.8",
      "edition_verse_id": "BSB:PSA.145.8",
      "verse": 8,
      "spans": [
        {
          "text": "The LORD is gracious and compassionate, slow to anger and abounding in loving devotion.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.9",
      "edition_verse_id": "BSB:PSA.145.9",
      "verse": 9,
      "spans": [
        {
          "text": "The LORD is good to all; His compassion rests on all He has made.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.10",
      "edition_verse_id": "BSB:PSA.145.10",
      "verse": 10,
      "spans": [
        {
          "text": "All You have made will give You thanks, O LORD, and Your saints will bless You.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.11",
      "edition_verse_id": "BSB:PSA.145.11",
      "verse": 11,
      "spans": [
        {
          "text": "They will tell of the glory of Your kingdom and speak of Your might,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.12",
      "edition_verse_id": "BSB:PSA.145.12",
      "verse": 12,
      "spans": [
        {
          "text": "to make known to men Your mighty acts and the glorious splendor of Your kingdom.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.13",
      "edition_verse_id": "BSB:PSA.145.13",
      "verse": 13,
      "spans": [
        {
          "text": "Your kingdom is an everlasting kingdom, and Your dominion endures through all generations. The LORD is faithful in all His words and kind in all His actions.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.14",
      "edition_verse_id": "BSB:PSA.145.14",
      "verse": 14,
      "spans": [
        {
          "text": "The LORD upholds all who fall and lifts up all who are bowed down.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.15",
      "edition_verse_id": "BSB:PSA.145.15",
      "verse": 15,
      "spans": [
        {
          "text": "The eyes of all look to You, and You give them their food in season.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.16",
      "edition_verse_id": "BSB:PSA.145.16",
      "verse": 16,
      "spans": [
        {
          "text": "You open Your hand and satisfy the desire of every living thing.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.17",
      "edition_verse_id": "BSB:PSA.145.17",
      "verse": 17,
      "spans": [
        {
          "text": "The LORD is righteous in all His ways and kind in all His deeds.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.18",
      "edition_verse_id": "BSB:PSA.145.18",
      "verse": 18,
      "spans": [
        {
          "text": "The LORD is near to all who call on Him, to all who call out to Him in truth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.19",
      "edition_verse_id": "BSB:PSA.145.19",
      "verse": 19,
      "spans": [
        {
          "text": "He fulfills the desires of those who fear Him; He hears their cry and saves them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.20",
      "edition_verse_id": "BSB:PSA.145.20",
      "verse": 20,
      "spans": [
        {
          "text": "The LORD preserves all who love Him, but all the wicked He will destroy.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.145.21",
      "edition_verse_id": "BSB:PSA.145.21",
      "verse": 21,
      "spans": [
        {
          "text": "My mouth will declare the praise of the LORD; let every creature bless His holy name forever and ever.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
