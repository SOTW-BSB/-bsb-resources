{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 146,
  "verses": [
    {
      "id": "PSA.146.1",
      "edition_verse_id": "BSB:PSA.146.1",
      "verse": 1,
      "spans": [
        {
          "text": "Hallelujah! Praise the LORD, O my soul.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.146.2",
      "edition_verse_id": "BSB:PSA.146.2",
      "verse": 2,
      "spans": [
        {
          "text": "I will praise the LORD all my life; I will sing praises to my God while I have my being.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.146.3",
      "edition_verse_id": "BSB:PSA.146.3",
      "verse": 3,
      "spans": [
        {
          "text": "Put not your trust in princes, in mortal man, who cannot save.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.146.4",
      "edition_verse_id": "BSB:PSA.146.4",
      "verse": 4,
      "spans": [
        {
          "text": "When his spirit departs, he returns to the ground; on that very day his plans perish.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.146.5",
      "edition_verse_id": "BSB:PSA.146.5",
      "verse": 5,
      "spans": [
        {
          "text": "Blessed is he whose help is the God of Jacob, whose hope is in the LORD his God,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.146.6",
      "edition_verse_id": "BSB:PSA.146.6",
      "verse": 6,
      "spans": [
        {
          "text": "the Maker of heaven and earth, the sea, and everything in them. He remains faithful forever.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.146.7",
      "edition_verse_id": "BSB:PSA.146.7",
      "verse": 7,
      "spans": [
        {
          "text": "He executes justice for the oppressed and gives food to the hungry. The LORD sets the prisoners free,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.146.8",
      "edition_verse_id": "BSB:PSA.146.8",
      "verse": 8,
      "spans": [
        {
          "text": "the LORD opens the eyes of the blind, the LORD lifts those who are weighed down, the LORD loves the righteous.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.146.9",
      "edition_verse_id": "BSB:PSA.146.9",
      "verse": 9,
      "spans": [
        {
          "text": "The LORD protects foreigners; He sustains the fatherless and the widow, but the ways of the wicked He frustrates.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.146.10",
      "edition_verse_id": "BSB:PSA.146.10",
      "verse": 10,
      "spans": [
        {
          "text": "The LORD reigns forever, your God, O Zion, for all generations. Hallelujah!",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
