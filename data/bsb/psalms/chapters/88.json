{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 88,
  "verses": [
    {
      "id": "PSA.88.1",
      "edition_verse_id": "BSB:PSA.88.1",
      "verse": 1,
      "spans": [
        {
          "text": "A song. A Psalm of the sons of Korah. For the choirmaster. According to Mahalath Leannoth. A Maskil of Heman the Ezrahite. O LORD, the God of my salvation, day and night I cry out before You.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.88.2",
      "edition_verse_id": "BSB:PSA.88.2",
      "verse": 2,
      "spans": [
        {
          "text": "May my prayer come before You; incline Your ear to my cry.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.3",
      "edition_verse_id": "BSB:PSA.88.3",
      "verse": 3,
      "spans": [
        {
          "text": "For my soul is full of troubles, and my life draws near to Sheol.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.4",
      "edition_verse_id": "BSB:PSA.88.4",
      "verse": 4,
      "spans": [
        {
          "text": "I am counted among those descending to the Pit. I am like a man without strength.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.5",
      "edition_verse_id": "BSB:PSA.88.5",
      "verse": 5,
      "spans": [
        {
          "text": "I am forsaken among the dead, like the slain who lie in the grave, whom You remember no more, who are cut off from Your care.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.6",
      "edition_verse_id": "BSB:PSA.88.6",
      "verse": 6,
      "spans": [
        {
          "text": "You have laid me in the lowest Pit, in the darkest of the depths.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.7",
      "edition_verse_id": "BSB:PSA.88.7",
      "verse": 7,
      "spans": [
        {
          "text": "Your wrath weighs heavily upon me; all Your waves have submerged me. Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.8",
      "edition_verse_id": "BSB:PSA.88.8",
      "verse": 8,
      "spans": [
        {
          "text": "You have removed my friends from me; You have made me repulsive to them; I am confined and cannot escape.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.9",
      "edition_verse_id": "BSB:PSA.88.9",
      "verse": 9,
      "spans": [
        {
          "text": "My eyes grow dim with grief. I call to You daily, O LORD; I spread out my hands to You.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.10",
      "edition_verse_id": "BSB:PSA.88.10",
      "verse": 10,
      "spans": [
        {
          "text": "Do You work wonders for the dead? Do departed spirits rise up to praise You? Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.11",
      "edition_verse_id": "BSB:PSA.88.11",
      "verse": 11,
      "spans": [
        {
          "text": "Can Your loving devotion be proclaimed in the grave, Your faithfulness in Abaddon?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.12",
      "edition_verse_id": "BSB:PSA.88.12",
      "verse": 12,
      "spans": [
        {
          "text": "Will Your wonders be known in the darkness, or Your righteousness in the land of oblivion?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.13",
      "edition_verse_id": "BSB:PSA.88.13",
      "verse": 13,
      "spans": [
        {
          "text": "But to You, O LORD, I cry for help; in the morning my prayer comes before You.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.14",
      "edition_verse_id": "BSB:PSA.88.14",
      "verse": 14,
      "spans": [
        {
          "text": "Why, O LORD, do You reject me? Why do You hide Your face from me?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.15",
      "edition_verse_id": "BSB:PSA.88.15",
      "verse": 15,
      "spans": [
        {
          "text": "From my youth I was afflicted and near death. I have borne Your terrors; I am in despair.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.16",
      "edition_verse_id": "BSB:PSA.88.16",
      "verse": 16,
      "spans": [
        {
          "text": "Your wrath has swept over me; Your terrors have destroyed me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.17",
      "edition_verse_id": "BSB:PSA.88.17",
      "verse": 17,
      "spans": [
        {
          "text": "All day long they engulf me like water; they enclose me on every side.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.88.18",
      "edition_verse_id": "BSB:PSA.88.18",
      "verse": 18,
      "spans": [
        {
          "text": "You have removed my beloved and my friend; darkness is my closest companion.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
