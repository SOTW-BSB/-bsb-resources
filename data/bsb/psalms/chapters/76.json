{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 76,
  "verses": [
    {
      "id": "PSA.76.1",
      "edition_verse_id": "BSB:PSA.76.1",
      "verse": 1,
      "spans": [
        {
          "text": "For the choirmaster. With stringed instruments. A Psalm of Asaph. A song. God is known in Judah; His name is great in Israel.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.76.2",
      "edition_verse_id": "BSB:PSA.76.2",
      "verse": 2,
      "spans": [
        {
          "text": "His tent is in Salem, His dwelling place in Zion.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.76.3",
      "edition_verse_id": "BSB:PSA.76.3",
      "verse": 3,
      "spans": [
        {
          "text": "There He shattered the flaming arrows, the shield and sword and weapons of war. Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.76.4",
      "edition_verse_id": "BSB:PSA.76.4",
      "verse": 4,
      "spans": [
        {
          "text": "You are resplendent with light, more majestic than mountains filled with game.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.76.5",
      "edition_verse_id": "BSB:PSA.76.5",
      "verse": 5,
      "spans": [
        {
          "text": "The valiant lie plundered; they sleep their last sleep. No men of might could lift a hand.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.76.6",
      "edition_verse_id": "BSB:PSA.76.6",
      "verse": 6,
      "spans": [
        {
          "text": "At Your rebuke, O God of Jacob, both horse and rider lie stunned.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.76.7",
      "edition_verse_id": "BSB:PSA.76.7",
      "verse": 7,
      "spans": [
        {
          "text": "You alone are to be feared. When You are angry, who can stand before You?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.76.8",
      "edition_verse_id": "BSB:PSA.76.8",
      "verse": 8,
      "spans": [
        {
          "text": "From heaven You pronounced judgment, and the earth feared and was still",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.76.9",
      "edition_verse_id": "BSB:PSA.76.9",
      "verse": 9,
      "spans": [
        {
          "text": "when God rose up to judge, to save all the lowly of the earth. Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.76.10",
      "edition_verse_id": "BSB:PSA.76.10",
      "verse": 10,
      "spans": [
        {
          "text": "Even the wrath of man shall praise You; with the survivors of wrath You will clothe Yourself.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.76.11",
      "edition_verse_id": "BSB:PSA.76.11",
      "verse": 11,
      "spans": [
        {
          "text": "Make and fulfill your vows to the LORD your God; let all the neighboring lands bring tribute to Him who is to be feared.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.76.12",
      "edition_verse_id": "BSB:PSA.76.12",
      "verse": 12,
      "spans": [
        {
          "text": "He breaks the spirits of princes; He is feared by the kings of the earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
