{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 87,
  "verses": [
    {
      "id": "PSA.87.1",
      "edition_verse_id": "BSB:PSA.87.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Psalm of the sons of Korah. A song. He has founded His city on the holy mountains.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.87.2",
      "edition_verse_id": "BSB:PSA.87.2",
      "verse": 2,
      "spans": [
        {
          "text": "The LORD loves the gates of Zion more than all the dwellings of Jacob.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.87.3",
      "edition_verse_id": "BSB:PSA.87.3",
      "verse": 3,
      "spans": [
        {
          "text": "Glorious things are ascribed to you, O city of God. Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.87.4",
      "edition_verse_id": "BSB:PSA.87.4",
      "verse": 4,
      "spans": [
        {
          "text": "“I will mention Rahab and Babylon among those who know Me — along with Philistia, Tyre, and Cush — when I say, ‘This one was born in Zion.’”",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.87.5",
      "edition_verse_id": "BSB:PSA.87.5",
      "verse": 5,
      "spans": [
        {
          "text": "And it will be said of Zion: “This one and that one were born in her, and the Most High Himself will establish her.”",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.87.6",
      "edition_verse_id": "BSB:PSA.87.6",
      "verse": 6,
      "spans": [
        {
          "text": "The LORD will record in the register of the peoples: “This one was born in Zion.” Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.87.7",
      "edition_verse_id": "BSB:PSA.87.7",
      "verse": 7,
      "spans": [
        {
          "text": "Singers and pipers will proclaim, “All my springs of joy are in You.”",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
