{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 123,
  "verses": [
    {
      "id": "PSA.123.1",
      "edition_verse_id": "BSB:PSA.123.1",
      "verse": 1,
      "spans": [
        {
          "text": "A song of ascents. I lift up my eyes to You, the One enthroned in heaven.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.123.2",
      "edition_verse_id": "BSB:PSA.123.2",
      "verse": 2,
      "spans": [
        {
          "text": "As the eyes of servants look to the hand of their master, as the eyes of a maidservant look to the hand of her mistress, so our eyes are on the LORD our God until He shows us mercy.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.123.3",
      "edition_verse_id": "BSB:PSA.123.3",
      "verse": 3,
      "spans": [
        {
          "text": "Have mercy on us, O LORD, have mercy, for we have endured much contempt.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.123.4",
      "edition_verse_id": "BSB:PSA.123.4",
      "verse": 4,
      "spans": [
        {
          "text": "We have endured much scorn from the arrogant, much contempt from the proud.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
