{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 4,
  "verses": [
    {
      "id": "PSA.4.1",
      "edition_verse_id": "BSB:PSA.4.1",
      "verse": 1,
      "spans": [
        {
          "text": "For the choirmaster. With stringed instruments. A Psalm of David. Answer me when I call, O God of my righteousness! You have relieved my distress; show me grace and hear my prayer.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.4.2",
      "edition_verse_id": "BSB:PSA.4.2",
      "verse": 2,
      "spans": [
        {
          "text": "How long, O men, will my honor be maligned? How long will you love vanity and seek after lies? Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.4.3",
      "edition_verse_id": "BSB:PSA.4.3",
      "verse": 3,
      "spans": [
        {
          "text": "Know that the LORD has set apart the godly for Himself; the LORD hears when I call to Him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.4.4",
      "edition_verse_id": "BSB:PSA.4.4",
      "verse": 4,
      "spans": [
        {
          "text": "Be angry, yet do not sin; on your bed, search your heart and be still. Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.4.5",
      "edition_verse_id": "BSB:PSA.4.5",
      "verse": 5,
      "spans": [
        {
          "text": "Offer the sacrifices of the righteous and trust in the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.4.6",
      "edition_verse_id": "BSB:PSA.4.6",
      "verse": 6,
      "spans": [
        {
          "text": "Many ask, “Who can show us the good?” Shine the light of Your face upon us, O LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.4.7",
      "edition_verse_id": "BSB:PSA.4.7",
      "verse": 7,
      "spans": [
        {
          "text": "You have filled my heart with more joy than when grain and new wine abound.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.4.8",
      "edition_verse_id": "BSB:PSA.4.8",
      "verse": 8,
      "spans": [
        {
          "text": "I will lie down and sleep in peace, for You alone, O LORD, make me dwell in safety.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
