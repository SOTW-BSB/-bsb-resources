{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 86,
  "verses": [
    {
      "id": "PSA.86.1",
      "edition_verse_id": "BSB:PSA.86.1",
      "verse": 1,
      "spans": [
        {
          "text": "A prayer of David. Incline Your ear, O LORD, and answer me, for I am poor and needy.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.86.2",
      "edition_verse_id": "BSB:PSA.86.2",
      "verse": 2,
      "spans": [
        {
          "text": "Preserve my soul, for I am godly. You are my God; save Your servant who trusts in You.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.3",
      "edition_verse_id": "BSB:PSA.86.3",
      "verse": 3,
      "spans": [
        {
          "text": "Be merciful to me, O Lord, for I call to You all day long.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.4",
      "edition_verse_id": "BSB:PSA.86.4",
      "verse": 4,
      "spans": [
        {
          "text": "Bring joy to Your servant, for to You, O Lord, I lift up my soul.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.5",
      "edition_verse_id": "BSB:PSA.86.5",
      "verse": 5,
      "spans": [
        {
          "text": "For You, O Lord, are kind and forgiving, rich in loving devotion to all who call on You.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.6",
      "edition_verse_id": "BSB:PSA.86.6",
      "verse": 6,
      "spans": [
        {
          "text": "Hear my prayer, O LORD, and attend to my plea for mercy.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.7",
      "edition_verse_id": "BSB:PSA.86.7",
      "verse": 7,
      "spans": [
        {
          "text": "In the day of my distress I call on You, because You answer me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.8",
      "edition_verse_id": "BSB:PSA.86.8",
      "verse": 8,
      "spans": [
        {
          "text": "O Lord, there is none like You among the gods, nor any works like Yours.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.9",
      "edition_verse_id": "BSB:PSA.86.9",
      "verse": 9,
      "spans": [
        {
          "text": "All the nations You have made will come and bow before You, O Lord, and they will glorify Your name.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.10",
      "edition_verse_id": "BSB:PSA.86.10",
      "verse": 10,
      "spans": [
        {
          "text": "For You are great and perform wonders; You alone are God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.11",
      "edition_verse_id": "BSB:PSA.86.11",
      "verse": 11,
      "spans": [
        {
          "text": "Teach me Your way, O LORD, that I may walk in Your truth. Give me an undivided heart, that I may fear Your name.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.12",
      "edition_verse_id": "BSB:PSA.86.12",
      "verse": 12,
      "spans": [
        {
          "text": "I will praise You, O Lord my God, with all my heart; I will glorify Your name forever.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.13",
      "edition_verse_id": "BSB:PSA.86.13",
      "verse": 13,
      "spans": [
        {
          "text": "For great is Your loving devotion to me; You have delivered me from the depths of Sheol.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.14",
      "edition_verse_id": "BSB:PSA.86.14",
      "verse": 14,
      "spans": [
        {
          "text": "The arrogant rise against me, O God; a band of ruthless men seeks my life; they have no regard for You.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.15",
      "edition_verse_id": "BSB:PSA.86.15",
      "verse": 15,
      "spans": [
        {
          "text": "But You, O Lord, are a compassionate and gracious God, slow to anger, abounding in loving devotion and faithfulness.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.16",
      "edition_verse_id": "BSB:PSA.86.16",
      "verse": 16,
      "spans": [
        {
          "text": "Turn to me and have mercy; grant Your strength to Your servant; save the son of Your maidservant.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.86.17",
      "edition_verse_id": "BSB:PSA.86.17",
      "verse": 17,
      "spans": [
        {
          "text": "Show me a sign of Your goodness, that my enemies may see and be ashamed; for You, O LORD, have helped me and comforted me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
