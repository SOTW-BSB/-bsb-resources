{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 121,
  "verses": [
    {
      "id": "PSA.121.1",
      "edition_verse_id": "BSB:PSA.121.1",
      "verse": 1,
      "spans": [
        {
          "text": "A song of ascents. I lift up my eyes to the hills. From where does my help come?",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.121.2",
      "edition_verse_id": "BSB:PSA.121.2",
      "verse": 2,
      "spans": [
        {
          "text": "My help comes from the LORD, the Maker of heaven and earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.121.3",
      "edition_verse_id": "BSB:PSA.121.3",
      "verse": 3,
      "spans": [
        {
          "text": "He will not allow your foot to slip; your Protector will not slumber.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.121.4",
      "edition_verse_id": "BSB:PSA.121.4",
      "verse": 4,
      "spans": [
        {
          "text": "Behold, the Protector of Israel will neither slumber nor sleep.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.121.5",
      "edition_verse_id": "BSB:PSA.121.5",
      "verse": 5,
      "spans": [
        {
          "text": "The LORD is your keeper; the LORD is the shade on your right hand.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.121.6",
      "edition_verse_id": "BSB:PSA.121.6",
      "verse": 6,
      "spans": [
        {
          "text": "The sun will not strike you by day, nor the moon by night.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.121.7",
      "edition_verse_id": "BSB:PSA.121.7",
      "verse": 7,
      "spans": [
        {
          "text": "The LORD will guard you from all evil; He will preserve your soul.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.121.8",
      "edition_verse_id": "BSB:PSA.121.8",
      "verse": 8,
      "spans": [
        {
          "text": "The LORD will watch over your coming and going, both now and forevermore.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
