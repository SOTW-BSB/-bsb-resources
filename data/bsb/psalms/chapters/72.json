{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 72,
  "verses": [
    {
      "id": "PSA.72.1",
      "edition_verse_id": "BSB:PSA.72.1",
      "verse": 1,
      "spans": [
        {
          "text": "Of Solomon. Endow the king with Your justice, O God, and the son of the king with Your righteousness.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.72.2",
      "edition_verse_id": "BSB:PSA.72.2",
      "verse": 2,
      "spans": [
        {
          "text": "May he judge Your people with righteousness and Your afflicted with justice.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.3",
      "edition_verse_id": "BSB:PSA.72.3",
      "verse": 3,
      "spans": [
        {
          "text": "May the mountains bring peace to the people, and the hills bring righteousness.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.4",
      "edition_verse_id": "BSB:PSA.72.4",
      "verse": 4,
      "spans": [
        {
          "text": "May he vindicate the afflicted among the people; may he save the children of the needy and crush the oppressor.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.5",
      "edition_verse_id": "BSB:PSA.72.5",
      "verse": 5,
      "spans": [
        {
          "text": "May they fear him as long as the sun shines, as long as the moon remains, through all generations.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.6",
      "edition_verse_id": "BSB:PSA.72.6",
      "verse": 6,
      "spans": [
        {
          "text": "May he be like rain that falls on freshly cut grass, like spring showers that water the earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.7",
      "edition_verse_id": "BSB:PSA.72.7",
      "verse": 7,
      "spans": [
        {
          "text": "May the righteous flourish in his days and prosperity abound until the moon is no more.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.8",
      "edition_verse_id": "BSB:PSA.72.8",
      "verse": 8,
      "spans": [
        {
          "text": "May he rule from sea to sea, and from the Euphrates to the ends of the earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.9",
      "edition_verse_id": "BSB:PSA.72.9",
      "verse": 9,
      "spans": [
        {
          "text": "May the nomads bow before him, and his enemies lick the dust.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.10",
      "edition_verse_id": "BSB:PSA.72.10",
      "verse": 10,
      "spans": [
        {
          "text": "May the kings of Tarshish and distant shores bring tribute; may the kings of Sheba and Seba offer gifts.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.11",
      "edition_verse_id": "BSB:PSA.72.11",
      "verse": 11,
      "spans": [
        {
          "text": "May all kings bow down to him and all nations serve him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.12",
      "edition_verse_id": "BSB:PSA.72.12",
      "verse": 12,
      "spans": [
        {
          "text": "For he will deliver the needy who cry out and the afflicted who have no helper.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.13",
      "edition_verse_id": "BSB:PSA.72.13",
      "verse": 13,
      "spans": [
        {
          "text": "He will take pity on the poor and needy and save the lives of the oppressed.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.14",
      "edition_verse_id": "BSB:PSA.72.14",
      "verse": 14,
      "spans": [
        {
          "text": "He will redeem them from oppression and violence, for their blood is precious in his sight.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.15",
      "edition_verse_id": "BSB:PSA.72.15",
      "verse": 15,
      "spans": [
        {
          "text": "Long may he live! May gold from Sheba be given him. May people ever pray for him; may they bless him all day long.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.16",
      "edition_verse_id": "BSB:PSA.72.16",
      "verse": 16,
      "spans": [
        {
          "text": "May there be an abundance of grain in the land; may it sway atop the hills. May its fruit trees flourish like the forests of Lebanon, the people of its cities like the grass of the field.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.17",
      "edition_verse_id": "BSB:PSA.72.17",
      "verse": 17,
      "spans": [
        {
          "text": "May his name endure forever; may his name continue as long as the sun shines. In him may all nations be blessed; may they call him blessed.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.18",
      "edition_verse_id": "BSB:PSA.72.18",
      "verse": 18,
      "spans": [
        {
          "text": "Blessed be the LORD God, the God of Israel, who alone does marvelous deeds.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.19",
      "edition_verse_id": "BSB:PSA.72.19",
      "verse": 19,
      "spans": [
        {
          "text": "And blessed be His glorious name forever; may all the earth be filled with His glory. Amen and amen.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.72.20",
      "edition_verse_id": "BSB:PSA.72.20",
      "verse": 20,
      "spans": [
        {
          "text": "Thus conclude the prayers of David son of Jesse.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    }
  ]
}
