{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 110,
  "verses": [
    {
      "id": "PSA.110.1",
      "edition_verse_id": "BSB:PSA.110.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Psalm of David. The LORD said to my Lord: “Sit at My right hand until I make Your enemies a footstool for Your feet.”",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.110.2",
      "edition_verse_id": "BSB:PSA.110.2",
      "verse": 2,
      "spans": [
        {
          "text": "The LORD extends Your mighty scepter from Zion: “Rule in the midst of Your enemies.”",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.110.3",
      "edition_verse_id": "BSB:PSA.110.3",
      "verse": 3,
      "spans": [
        {
          "text": "Your people shall be willing on Your day of battle. Arrayed in holy splendor, from the womb of the dawn, to You belongs the dew of Your youth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.110.4",
      "edition_verse_id": "BSB:PSA.110.4",
      "verse": 4,
      "spans": [
        {
          "text": "The LORD has sworn and will not change His mind: “You are a priest forever in the order of Melchizedek.”",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.110.5",
      "edition_verse_id": "BSB:PSA.110.5",
      "verse": 5,
      "spans": [
        {
          "text": "The Lord is at Your right hand; He will crush kings in the day of His wrath.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.110.6",
      "edition_verse_id": "BSB:PSA.110.6",
      "verse": 6,
      "spans": [
        {
          "text": "He will judge the nations, heaping up the dead; He will crush the leaders far and wide.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.110.7",
      "edition_verse_id": "BSB:PSA.110.7",
      "verse": 7,
      "spans": [
        {
          "text": "He will drink from the brook by the road; therefore He will lift up His head.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
