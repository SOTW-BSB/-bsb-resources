{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 34,
  "verses": [
    {
      "id": "PSA.34.1",
      "edition_verse_id": "BSB:PSA.34.1",
      "verse": 1,
      "spans": [
        {
          "text": "Of David, when he pretended to be insane before Abimelech, so that the king drove him away. I will bless the LORD at all times; His praise will always be on my lips.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.34.2",
      "edition_verse_id": "BSB:PSA.34.2",
      "verse": 2,
      "spans": [
        {
          "text": "My soul boasts in the LORD; let the oppressed hear and rejoice.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.3",
      "edition_verse_id": "BSB:PSA.34.3",
      "verse": 3,
      "spans": [
        {
          "text": "Magnify the LORD with me; let us exalt His name together.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.4",
      "edition_verse_id": "BSB:PSA.34.4",
      "verse": 4,
      "spans": [
        {
          "text": "I sought the LORD, and He answered me; He delivered me from all my fears.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.5",
      "edition_verse_id": "BSB:PSA.34.5",
      "verse": 5,
      "spans": [
        {
          "text": "Those who look to Him are radiant with joy; their faces shall never be ashamed.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.6",
      "edition_verse_id": "BSB:PSA.34.6",
      "verse": 6,
      "spans": [
        {
          "text": "This poor man called out, and the LORD heard him; He saved him from all his troubles.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.7",
      "edition_verse_id": "BSB:PSA.34.7",
      "verse": 7,
      "spans": [
        {
          "text": "The angel of the LORD encamps around those who fear Him, and he delivers them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.8",
      "edition_verse_id": "BSB:PSA.34.8",
      "verse": 8,
      "spans": [
        {
          "text": "Taste and see that the LORD is good; blessed is the man who takes refuge in Him!",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.9",
      "edition_verse_id": "BSB:PSA.34.9",
      "verse": 9,
      "spans": [
        {
          "text": "Fear the LORD, you His saints, for those who fear Him lack nothing.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.10",
      "edition_verse_id": "BSB:PSA.34.10",
      "verse": 10,
      "spans": [
        {
          "text": "Young lions go lacking and hungry, but those who seek the LORD lack no good thing.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.11",
      "edition_verse_id": "BSB:PSA.34.11",
      "verse": 11,
      "spans": [
        {
          "text": "Come, children, listen to me; I will teach you the fear of the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.12",
      "edition_verse_id": "BSB:PSA.34.12",
      "verse": 12,
      "spans": [
        {
          "text": "Who is the man who delights in life, who desires to see good days?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.13",
      "edition_verse_id": "BSB:PSA.34.13",
      "verse": 13,
      "spans": [
        {
          "text": "Keep your tongue from evil and your lips from deceitful speech.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.14",
      "edition_verse_id": "BSB:PSA.34.14",
      "verse": 14,
      "spans": [
        {
          "text": "Turn away from evil and do good; seek peace and pursue it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.15",
      "edition_verse_id": "BSB:PSA.34.15",
      "verse": 15,
      "spans": [
        {
          "text": "The eyes of the LORD are on the righteous, and His ears are inclined to their cry.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.16",
      "edition_verse_id": "BSB:PSA.34.16",
      "verse": 16,
      "spans": [
        {
          "text": "But the face of the LORD is against those who do evil, to wipe out all memory of them from the earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.17",
      "edition_verse_id": "BSB:PSA.34.17",
      "verse": 17,
      "spans": [
        {
          "text": "The righteous cry out, and the LORD hears; He delivers them from all their troubles.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.18",
      "edition_verse_id": "BSB:PSA.34.18",
      "verse": 18,
      "spans": [
        {
          "text": "The LORD is near to the brokenhearted; He saves the contrite in spirit.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.19",
      "edition_verse_id": "BSB:PSA.34.19",
      "verse": 19,
      "spans": [
        {
          "text": "Many are the afflictions of the righteous, but the LORD delivers him from them all.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.20",
      "edition_verse_id": "BSB:PSA.34.20",
      "verse": 20,
      "spans": [
        {
          "text": "He protects all his bones; not one of them will be broken.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.21",
      "edition_verse_id": "BSB:PSA.34.21",
      "verse": 21,
      "spans": [
        {
          "text": "Evil will slay the wicked, and the haters of the righteous will be condemned.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.34.22",
      "edition_verse_id": "BSB:PSA.34.22",
      "verse": 22,
      "spans": [
        {
          "text": "The LORD redeems His servants, and none who take refuge in Him will be condemned.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
