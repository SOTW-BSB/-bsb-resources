{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 2,
  "verses": [
    {
      "id": "PSA.2.1",
      "edition_verse_id": "BSB:PSA.2.1",
      "verse": 1,
      "spans": [
        {
          "text": "Why do the nations rage and the peoples plot in vain?",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.2.2",
      "edition_verse_id": "BSB:PSA.2.2",
      "verse": 2,
      "spans": [
        {
          "text": "The kings of the earth take their stand and the rulers gather together, against the LORD and against His Anointed One:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.2.3",
      "edition_verse_id": "BSB:PSA.2.3",
      "verse": 3,
      "spans": [
        {
          "text": "“Let us break Their chains and cast away Their cords.”",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.2.4",
      "edition_verse_id": "BSB:PSA.2.4",
      "verse": 4,
      "spans": [
        {
          "text": "The One enthroned in heaven laughs; the Lord taunts them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.2.5",
      "edition_verse_id": "BSB:PSA.2.5",
      "verse": 5,
      "spans": [
        {
          "text": "Then He rebukes them in His anger, and terrifies them in His fury:",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.2.6",
      "edition_verse_id": "BSB:PSA.2.6",
      "verse": 6,
      "spans": [
        {
          "text": "“I have installed My King on Zion, upon My holy mountain.”",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.2.7",
      "edition_verse_id": "BSB:PSA.2.7",
      "verse": 7,
      "spans": [
        {
          "text": "I will proclaim the decree spoken to Me by the LORD: “You are My Son; today I have become Your Father.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.2.8",
      "edition_verse_id": "BSB:PSA.2.8",
      "verse": 8,
      "spans": [
        {
          "text": "Ask Me, and I will make the nations Your inheritance, the ends of the earth Your possession.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.2.9",
      "edition_verse_id": "BSB:PSA.2.9",
      "verse": 9,
      "spans": [
        {
          "text": "You will break them with an iron scepter; You will shatter them like pottery.”",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.2.10",
      "edition_verse_id": "BSB:PSA.2.10",
      "verse": 10,
      "spans": [
        {
          "text": "Therefore be wise, O kings; be admonished, O judges of the earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.2.11",
      "edition_verse_id": "BSB:PSA.2.11",
      "verse": 11,
      "spans": [
        {
          "text": "Serve the LORD with fear, and rejoice with trembling.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.2.12",
      "edition_verse_id": "BSB:PSA.2.12",
      "verse": 12,
      "spans": [
        {
          "text": "Kiss the Son, lest He be angry and you perish in your rebellion, when His wrath ignites in an instant. Blessed are all who take refuge in Him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
