{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 13,
  "verses": [
    {
      "id": "PSA.13.1",
      "edition_verse_id": "BSB:PSA.13.1",
      "verse": 1,
      "spans": [
        {
          "text": "For the choirmaster. A Psalm of David. How long, O LORD? Will You forget me forever? How long will You hide Your face from me?",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.13.2",
      "edition_verse_id": "BSB:PSA.13.2",
      "verse": 2,
      "spans": [
        {
          "text": "How long must I wrestle in my soul, with sorrow in my heart each day? How long will my enemy dominate me?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.13.3",
      "edition_verse_id": "BSB:PSA.13.3",
      "verse": 3,
      "spans": [
        {
          "text": "Consider me and respond, O LORD my God. Give light to my eyes, lest I sleep in death,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.13.4",
      "edition_verse_id": "BSB:PSA.13.4",
      "verse": 4,
      "spans": [
        {
          "text": "lest my enemy say, “I have overcome him,” and my foes rejoice when I fall.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.13.5",
      "edition_verse_id": "BSB:PSA.13.5",
      "verse": 5,
      "spans": [
        {
          "text": "But I have trusted in Your loving devotion; my heart will rejoice in Your salvation.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.13.6",
      "edition_verse_id": "BSB:PSA.13.6",
      "verse": 6,
      "spans": [
        {
          "text": "I will sing to the LORD, for He has been good to me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
