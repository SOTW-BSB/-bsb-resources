{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 6,
  "verses": [
    {
      "id": "PSA.6.1",
      "edition_verse_id": "BSB:PSA.6.1",
      "verse": 1,
      "spans": [
        {
          "text": "For the choirmaster. With stringed instruments, according to Sheminith. A Psalm of David. O LORD, do not rebuke me in Your anger or discipline me in Your wrath.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.6.2",
      "edition_verse_id": "BSB:PSA.6.2",
      "verse": 2,
      "spans": [
        {
          "text": "Be merciful to me, O LORD, for I am frail; heal me, O LORD, for my bones are in agony.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.6.3",
      "edition_verse_id": "BSB:PSA.6.3",
      "verse": 3,
      "spans": [
        {
          "text": "My soul is deeply distressed. How long, O LORD, how long?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.6.4",
      "edition_verse_id": "BSB:PSA.6.4",
      "verse": 4,
      "spans": [
        {
          "text": "Turn, O LORD, and deliver my soul; save me because of Your loving devotion.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.6.5",
      "edition_verse_id": "BSB:PSA.6.5",
      "verse": 5,
      "spans": [
        {
          "text": "For there is no mention of You in death; who can praise You from Sheol?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.6.6",
      "edition_verse_id": "BSB:PSA.6.6",
      "verse": 6,
      "spans": [
        {
          "text": "I am weary from groaning; all night I flood my bed with weeping and drench my couch with tears.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.6.7",
      "edition_verse_id": "BSB:PSA.6.7",
      "verse": 7,
      "spans": [
        {
          "text": "My eyes fail from grief; they grow dim because of all my foes.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.6.8",
      "edition_verse_id": "BSB:PSA.6.8",
      "verse": 8,
      "spans": [
        {
          "text": "Depart from me, all you workers of iniquity, for the LORD has heard my weeping.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.6.9",
      "edition_verse_id": "BSB:PSA.6.9",
      "verse": 9,
      "spans": [
        {
          "text": "The LORD has heard my cry for mercy; the LORD accepts my prayer.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.6.10",
      "edition_verse_id": "BSB:PSA.6.10",
      "verse": 10,
      "spans": [
        {
          "text": "All my enemies will be ashamed and dismayed; they will turn back in sudden disgrace.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
