{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 115,
  "verses": [
    {
      "id": "PSA.115.1",
      "edition_verse_id": "BSB:PSA.115.1",
      "verse": 1,
      "spans": [
        {
          "text": "Not to us, O LORD, not to us, but to Your name be the glory, because of Your loving devotion, because of Your faithfulness.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.115.2",
      "edition_verse_id": "BSB:PSA.115.2",
      "verse": 2,
      "spans": [
        {
          "text": "Why should the nations say, “Where is their God?”",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.115.3",
      "edition_verse_id": "BSB:PSA.115.3",
      "verse": 3,
      "spans": [
        {
          "text": "Our God is in heaven; He does as He pleases.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.115.4",
      "edition_verse_id": "BSB:PSA.115.4",
      "verse": 4,
      "spans": [
        {
          "text": "Their idols are silver and gold, made by the hands of men.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.115.5",
      "edition_verse_id": "BSB:PSA.115.5",
      "verse": 5,
      "spans": [
        {
          "text": "They have mouths, but cannot speak; they have eyes, but cannot see;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.115.6",
      "edition_verse_id": "BSB:PSA.115.6",
      "verse": 6,
      "spans": [
        {
          "text": "they have ears, but cannot hear; they have noses, but cannot smell;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.115.7",
      "edition_verse_id": "BSB:PSA.115.7",
      "verse": 7,
      "spans": [
        {
          "text": "they have hands, but cannot feel; they have feet, but cannot walk; they cannot even clear their throats.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.115.8",
      "edition_verse_id": "BSB:PSA.115.8",
      "verse": 8,
      "spans": [
        {
          "text": "Those who make them become like them, as do all who trust in them.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.115.9",
      "edition_verse_id": "BSB:PSA.115.9",
      "verse": 9,
      "spans": [
        {
          "text": "O Israel, trust in the LORD! He is their help and shield.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.115.10",
      "edition_verse_id": "BSB:PSA.115.10",
      "verse": 10,
      "spans": [
        {
          "text": "O house of Aaron, trust in the LORD! He is their help and shield.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.115.11",
      "edition_verse_id": "BSB:PSA.115.11",
      "verse": 11,
      "spans": [
        {
          "text": "You who fear the LORD, trust in the LORD! He is their help and shield.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.115.12",
      "edition_verse_id": "BSB:PSA.115.12",
      "verse": 12,
      "spans": [
        {
          "text": "The LORD is mindful of us; He will bless us. He will bless the house of Israel; He will bless the house of Aaron;",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.115.13",
      "edition_verse_id": "BSB:PSA.115.13",
      "verse": 13,
      "spans": [
        {
          "text": "He will bless those who fear the LORD— small and great alike.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.115.14",
      "edition_verse_id": "BSB:PSA.115.14",
      "verse": 14,
      "spans": [
        {
          "text": "May the LORD give you increase, both you and your children.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.115.15",
      "edition_verse_id": "BSB:PSA.115.15",
      "verse": 15,
      "spans": [
        {
          "text": "May you be blessed by the LORD, the Maker of heaven and earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.115.16",
      "edition_verse_id": "BSB:PSA.115.16",
      "verse": 16,
      "spans": [
        {
          "text": "The highest heavens belong to the LORD, but the earth He has given to mankind.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.115.17",
      "edition_verse_id": "BSB:PSA.115.17",
      "verse": 17,
      "spans": [
        {
          "text": "It is not the dead who praise the LORD, nor any who descend into silence.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.115.18",
      "edition_verse_id": "BSB:PSA.115.18",
      "verse": 18,
      "spans": [
        {
          "text": "But it is we who will bless the LORD, both now and forevermore. Hallelujah!",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
