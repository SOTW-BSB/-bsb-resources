{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 46,
  "verses": [
    {
      "id": "PSA.46.1",
      "edition_verse_id": "BSB:PSA.46.1",
      "verse": 1,
      "spans": [
        {
          "text": "For the choirmaster. Of the sons of Korah. According to Alamoth. A song. God is our refuge and strength, an ever-present help in times of trouble.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.46.2",
      "edition_verse_id": "BSB:PSA.46.2",
      "verse": 2,
      "spans": [
        {
          "text": "Therefore we will not fear, though the earth is transformed and the mountains are toppled into the depths of the seas,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.46.3",
      "edition_verse_id": "BSB:PSA.46.3",
      "verse": 3,
      "spans": [
        {
          "text": "though their waters roar and foam and the mountains quake in the surge. Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.46.4",
      "edition_verse_id": "BSB:PSA.46.4",
      "verse": 4,
      "spans": [
        {
          "text": "There is a river whose streams delight the city of God, the holy place where the Most High dwells.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.46.5",
      "edition_verse_id": "BSB:PSA.46.5",
      "verse": 5,
      "spans": [
        {
          "text": "God is within her; she will not be moved. God will help her when morning dawns.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.46.6",
      "edition_verse_id": "BSB:PSA.46.6",
      "verse": 6,
      "spans": [
        {
          "text": "Nations rage, kingdoms crumble; the earth melts when He lifts His voice.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.46.7",
      "edition_verse_id": "BSB:PSA.46.7",
      "verse": 7,
      "spans": [
        {
          "text": "The LORD of Hosts is with us; the God of Jacob is our fortress. Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.46.8",
      "edition_verse_id": "BSB:PSA.46.8",
      "verse": 8,
      "spans": [
        {
          "text": "Come, see the works of the LORD, who brings devastation upon the earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.46.9",
      "edition_verse_id": "BSB:PSA.46.9",
      "verse": 9,
      "spans": [
        {
          "text": "He makes wars to cease throughout the earth; He breaks the bow and shatters the spear; He burns the shields in the fire.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.46.10",
      "edition_verse_id": "BSB:PSA.46.10",
      "verse": 10,
      "spans": [
        {
          "text": "“Be still and know that I am God; I will be exalted among the nations, I will be exalted over the earth.”",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.46.11",
      "edition_verse_id": "BSB:PSA.46.11",
      "verse": 11,
      "spans": [
        {
          "text": "The LORD of Hosts is with us; the God of Jacob is our fortress. Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
