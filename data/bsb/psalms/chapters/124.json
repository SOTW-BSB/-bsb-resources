{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 124,
  "verses": [
    {
      "id": "PSA.124.1",
      "edition_verse_id": "BSB:PSA.124.1",
      "verse": 1,
      "spans": [
        {
          "text": "A song of ascents. Of David. If the LORD had not been on our side— let Israel now declare—",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.124.2",
      "edition_verse_id": "BSB:PSA.124.2",
      "verse": 2,
      "spans": [
        {
          "text": "if the LORD had not been on our side when men attacked us,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.124.3",
      "edition_verse_id": "BSB:PSA.124.3",
      "verse": 3,
      "spans": [
        {
          "text": "when their anger flared against us, then they would have swallowed us alive,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.124.4",
      "edition_verse_id": "BSB:PSA.124.4",
      "verse": 4,
      "spans": [
        {
          "text": "then the floods would have engulfed us, then the torrent would have overwhelmed us,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.124.5",
      "edition_verse_id": "BSB:PSA.124.5",
      "verse": 5,
      "spans": [
        {
          "text": "then the raging waters would have swept us away.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.124.6",
      "edition_verse_id": "BSB:PSA.124.6",
      "verse": 6,
      "spans": [
        {
          "text": "Blessed be the LORD, who has not given us as prey to their teeth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.124.7",
      "edition_verse_id": "BSB:PSA.124.7",
      "verse": 7,
      "spans": [
        {
          "text": "We have escaped like a bird from the snare of the fowler; the net is torn, and we have slipped away.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.124.8",
      "edition_verse_id": "BSB:PSA.124.8",
      "verse": 8,
      "spans": [
        {
          "text": "Our help is in the name of the LORD, the Maker of heaven and earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
