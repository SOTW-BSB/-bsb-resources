{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 100,
  "verses": [
    {
      "id": "PSA.100.1",
      "edition_verse_id": "BSB:PSA.100.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Psalm of thanksgiving. Make a joyful noise to the LORD, all the earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.100.2",
      "edition_verse_id": "BSB:PSA.100.2",
      "verse": 2,
      "spans": [
        {
          "text": "Serve the LORD with gladness; come into His presence with joyful songs.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.100.3",
      "edition_verse_id": "BSB:PSA.100.3",
      "verse": 3,
      "spans": [
        {
          "text": "Know that the LORD is God. It is He who made us, and we are His; we are His people, and the sheep of His pasture.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.100.4",
      "edition_verse_id": "BSB:PSA.100.4",
      "verse": 4,
      "spans": [
        {
          "text": "Enter His gates with thanksgiving and His courts with praise; give thanks to Him and bless His name.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.100.5",
      "edition_verse_id": "BSB:PSA.100.5",
      "verse": 5,
      "spans": [
        {
          "text": "For the LORD is good, and His loving devotion endures forever; His faithfulness continues to all generations.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
