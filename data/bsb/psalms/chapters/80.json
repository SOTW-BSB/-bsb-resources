{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 80,
  "verses": [
    {
      "id": "PSA.80.1",
      "edition_verse_id": "BSB:PSA.80.1",
      "verse": 1,
      "spans": [
        {
          "text": "For the choirmaster. To the tune of “The Lilies of the Covenant.” A Psalm of Asaph. Hear us, O Shepherd of Israel, who leads Joseph like a flock; You who sit enthroned between the cherubim, shine forth",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.80.2",
      "edition_verse_id": "BSB:PSA.80.2",
      "verse": 2,
      "spans": [
        {
          "text": "before Ephraim, Benjamin, and Manasseh. Rally Your mighty power and come to save us.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.80.3",
      "edition_verse_id": "BSB:PSA.80.3",
      "verse": 3,
      "spans": [
        {
          "text": "Restore us, O God, and cause Your face to shine upon us, that we may be saved.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.80.4",
      "edition_verse_id": "BSB:PSA.80.4",
      "verse": 4,
      "spans": [
        {
          "text": "O LORD God of Hosts, how long will Your anger smolder against the prayers of Your people?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.80.5",
      "edition_verse_id": "BSB:PSA.80.5",
      "verse": 5,
      "spans": [
        {
          "text": "You fed them with the bread of tears and made them drink the full measure of their tears.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.80.6",
      "edition_verse_id": "BSB:PSA.80.6",
      "verse": 6,
      "spans": [
        {
          "text": "You make us contend with our neighbors; our enemies mock us.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.80.7",
      "edition_verse_id": "BSB:PSA.80.7",
      "verse": 7,
      "spans": [
        {
          "text": "Restore us, O God of Hosts, and cause Your face to shine upon us, that we may be saved.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.80.8",
      "edition_verse_id": "BSB:PSA.80.8",
      "verse": 8,
      "spans": [
        {
          "text": "You uprooted a vine from Egypt; You drove out the nations and transplanted it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.80.9",
      "edition_verse_id": "BSB:PSA.80.9",
      "verse": 9,
      "spans": [
        {
          "text": "You cleared the ground for it, and it took root and filled the land.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.80.10",
      "edition_verse_id": "BSB:PSA.80.10",
      "verse": 10,
      "spans": [
        {
          "text": "The mountains were covered by its shade, and the mighty cedars with its branches.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.80.11",
      "edition_verse_id": "BSB:PSA.80.11",
      "verse": 11,
      "spans": [
        {
          "text": "It sent out its branches to the Sea, and its shoots toward the River.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.80.12",
      "edition_verse_id": "BSB:PSA.80.12",
      "verse": 12,
      "spans": [
        {
          "text": "Why have You broken down its walls, so that all who pass by pick its fruit?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.80.13",
      "edition_verse_id": "BSB:PSA.80.13",
      "verse": 13,
      "spans": [
        {
          "text": "The boar from the forest ravages it, and the creatures of the field feed upon it.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.80.14",
      "edition_verse_id": "BSB:PSA.80.14",
      "verse": 14,
      "spans": [
        {
          "text": "Return, O God of Hosts, we pray! Look down from heaven and see! Attend to this vine—",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.80.15",
      "edition_verse_id": "BSB:PSA.80.15",
      "verse": 15,
      "spans": [
        {
          "text": "the root Your right hand has planted, the son You have raised up for Yourself.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.80.16",
      "edition_verse_id": "BSB:PSA.80.16",
      "verse": 16,
      "spans": [
        {
          "text": "Your vine has been cut down and burned; they perish at the rebuke of Your countenance.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.80.17",
      "edition_verse_id": "BSB:PSA.80.17",
      "verse": 17,
      "spans": [
        {
          "text": "Let Your hand be upon the man at Your right hand, on the son of man You have raised up for Yourself.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.80.18",
      "edition_verse_id": "BSB:PSA.80.18",
      "verse": 18,
      "spans": [
        {
          "text": "Then we will not turn away from You; revive us, and we will call on Your name.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.80.19",
      "edition_verse_id": "BSB:PSA.80.19",
      "verse": 19,
      "spans": [
        {
          "text": "Restore us, O LORD God of Hosts; cause Your face to shine upon us, that we may be saved.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
