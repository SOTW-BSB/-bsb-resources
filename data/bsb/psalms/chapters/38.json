{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 38,
  "verses": [
    {
      "id": "PSA.38.1",
      "edition_verse_id": "BSB:PSA.38.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Psalm of David, for remembrance. O LORD, do not rebuke me in Your anger or discipline me in Your wrath.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.38.2",
      "edition_verse_id": "BSB:PSA.38.2",
      "verse": 2,
      "spans": [
        {
          "text": "For Your arrows have pierced me deeply, and Your hand has pressed down on me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.3",
      "edition_verse_id": "BSB:PSA.38.3",
      "verse": 3,
      "spans": [
        {
          "text": "There is no soundness in my body because of Your anger; there is no rest in my bones because of my sin.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.4",
      "edition_verse_id": "BSB:PSA.38.4",
      "verse": 4,
      "spans": [
        {
          "text": "For my iniquities have overwhelmed me; they are a burden too heavy to bear.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.5",
      "edition_verse_id": "BSB:PSA.38.5",
      "verse": 5,
      "spans": [
        {
          "text": "My wounds are foul and festering because of my sinful folly.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.6",
      "edition_verse_id": "BSB:PSA.38.6",
      "verse": 6,
      "spans": [
        {
          "text": "I am bent and brought low; all day long I go about mourning.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.7",
      "edition_verse_id": "BSB:PSA.38.7",
      "verse": 7,
      "spans": [
        {
          "text": "For my loins are full of burning pain, and no soundness remains in my body.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.8",
      "edition_verse_id": "BSB:PSA.38.8",
      "verse": 8,
      "spans": [
        {
          "text": "I am numb and badly crushed; I groan in anguish of heart.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.9",
      "edition_verse_id": "BSB:PSA.38.9",
      "verse": 9,
      "spans": [
        {
          "text": "O Lord, my every desire is before You; my groaning is not hidden from You.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.10",
      "edition_verse_id": "BSB:PSA.38.10",
      "verse": 10,
      "spans": [
        {
          "text": "My heart pounds, my strength fails, and even the light of my eyes has faded.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.11",
      "edition_verse_id": "BSB:PSA.38.11",
      "verse": 11,
      "spans": [
        {
          "text": "My beloved and friends shun my disease, and my kinsmen stand at a distance.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.12",
      "edition_verse_id": "BSB:PSA.38.12",
      "verse": 12,
      "spans": [
        {
          "text": "Those who seek my life lay snares; those who wish me harm speak destruction, plotting deceit all day long.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.13",
      "edition_verse_id": "BSB:PSA.38.13",
      "verse": 13,
      "spans": [
        {
          "text": "But like a deaf man, I do not hear; and like a mute man, I do not open my mouth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.14",
      "edition_verse_id": "BSB:PSA.38.14",
      "verse": 14,
      "spans": [
        {
          "text": "I am like a man who cannot hear, whose mouth offers no reply.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.15",
      "edition_verse_id": "BSB:PSA.38.15",
      "verse": 15,
      "spans": [
        {
          "text": "I wait for You, O LORD; You will answer, O Lord my God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.16",
      "edition_verse_id": "BSB:PSA.38.16",
      "verse": 16,
      "spans": [
        {
          "text": "For I said, “Let them not gloat over me — those who taunt me when my foot slips.”",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.17",
      "edition_verse_id": "BSB:PSA.38.17",
      "verse": 17,
      "spans": [
        {
          "text": "For I am ready to fall, and my pain is ever with me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.18",
      "edition_verse_id": "BSB:PSA.38.18",
      "verse": 18,
      "spans": [
        {
          "text": "Yes, I confess my iniquity; I am troubled by my sin.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.19",
      "edition_verse_id": "BSB:PSA.38.19",
      "verse": 19,
      "spans": [
        {
          "text": "Many are my enemies without cause, and many hate me without reason.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.20",
      "edition_verse_id": "BSB:PSA.38.20",
      "verse": 20,
      "spans": [
        {
          "text": "Those who repay my good with evil attack me for pursuing the good.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.21",
      "edition_verse_id": "BSB:PSA.38.21",
      "verse": 21,
      "spans": [
        {
          "text": "Do not forsake me, O LORD; be not far from me, O my God.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.38.22",
      "edition_verse_id": "BSB:PSA.38.22",
      "verse": 22,
      "spans": [
        {
          "text": "Come quickly to help me, O Lord my Savior.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
