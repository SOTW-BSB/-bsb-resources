  "verses": [
    {
      "id": "PSA.67.1",
      "edition_verse_id": "BSB:PSA.67.1",
      "verse": 1,
      "spans": [
        {
          "text": "For the choirmaster. With stringed instruments. A Psalm. A song. May God be gracious to us and bless us, and cause His face to shine upon us, Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.67.2",
      "edition_verse_id": "BSB:PSA.67.2",
      "verse": 2,
      "spans": [
        {
          "text": "that Your ways may be known on earth, Your salvation among all nations.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.67.3",
      "edition_verse_id": "BSB:PSA.67.3",
      "verse": 3,
      "spans": [
        {
          "text": "Let the peoples praise You, O God; let all the peoples praise You.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.67.4",
      "edition_verse_id": "BSB:PSA.67.4",
      "verse": 4,
      "spans": [
        {
          "text": "Let the nations be glad and sing for joy, for You judge the peoples justly and lead the nations of the earth. Selah",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.67.5",
      "edition_verse_id": "BSB:PSA.67.5",
      "verse": 5,
      "spans": [
        {
          "text": "Let the peoples praise You, O God; let all the peoples praise You.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.67.6",
      "edition_verse_id": "BSB:PSA.67.6",
      "verse": 6,
      "spans": [
        {
          "text": "The earth has yielded its harvest; God, our God, blesses us.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.67.7",
      "edition_verse_id": "BSB:PSA.67.7",
      "verse": 7,
      "spans": [
        {
          "text": "God blesses us, that all the ends of the earth shall fear Him.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
