{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 116,
  "verses": [
    {
      "id": "PSA.116.1",
      "edition_verse_id": "BSB:PSA.116.1",
      "verse": 1,
      "spans": [
        {
          "text": "I love the LORD, for He has heard my voice — my appeal for mercy.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.116.2",
      "edition_verse_id": "BSB:PSA.116.2",
      "verse": 2,
      "spans": [
        {
          "text": "Because He has inclined His ear to me, I will call on Him as long as I live.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.116.3",
      "edition_verse_id": "BSB:PSA.116.3",
      "verse": 3,
      "spans": [
        {
          "text": "The ropes of death entangled me; the anguish of Sheol overcame me; I was confronted by trouble and sorrow.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.116.4",
      "edition_verse_id": "BSB:PSA.116.4",
      "verse": 4,
      "spans": [
        {
          "text": "Then I called on the name of the LORD: “O LORD, deliver my soul!”",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.116.5",
      "edition_verse_id": "BSB:PSA.116.5",
      "verse": 5,
      "spans": [
        {
          "text": "The LORD is gracious and righteous; our God is full of compassion.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.116.6",
      "edition_verse_id": "BSB:PSA.116.6",
      "verse": 6,
      "spans": [
        {
          "text": "The LORD preserves the simplehearted; I was helpless, and He saved me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.116.7",
      "edition_verse_id": "BSB:PSA.116.7",
      "verse": 7,
      "spans": [
        {
          "text": "Return to your rest, O my soul, for the LORD has been good to you.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.116.8",
      "edition_verse_id": "BSB:PSA.116.8",
      "verse": 8,
      "spans": [
        {
          "text": "For You have delivered my soul from death, my eyes from tears, my feet from stumbling.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.116.9",
      "edition_verse_id": "BSB:PSA.116.9",
      "verse": 9,
      "spans": [
        {
          "text": "I will walk before the LORD in the land of the living.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.116.10",
      "edition_verse_id": "BSB:PSA.116.10",
      "verse": 10,
      "spans": [
        {
          "text": "I believed, therefore I said, “I am greatly afflicted.”",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.116.11",
      "edition_verse_id": "BSB:PSA.116.11",
      "verse": 11,
      "spans": [
        {
          "text": "In my alarm I said, “All men are liars!”",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.116.12",
      "edition_verse_id": "BSB:PSA.116.12",
      "verse": 12,
      "spans": [
        {
          "text": "How can I repay the LORD for all His goodness to me?",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.116.13",
      "edition_verse_id": "BSB:PSA.116.13",
      "verse": 13,
      "spans": [
        {
          "text": "I will lift the cup of salvation and call on the name of the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.116.14",
      "edition_verse_id": "BSB:PSA.116.14",
      "verse": 14,
      "spans": [
        {
          "text": "I will fulfill my vows to the LORD in the presence of all His people.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.116.15",
      "edition_verse_id": "BSB:PSA.116.15",
      "verse": 15,
      "spans": [
        {
          "text": "Precious in the sight of the LORD is the death of His saints.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.116.16",
      "edition_verse_id": "BSB:PSA.116.16",
      "verse": 16,
      "spans": [
        {
          "text": "Truly, O LORD, I am Your servant; I am Your servant, the son of Your maidservant; You have broken my bonds.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.116.17",
      "edition_verse_id": "BSB:PSA.116.17",
      "verse": 17,
      "spans": [
        {
          "text": "I will offer to You a sacrifice of thanksgiving and call on the name of the LORD.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.116.18",
      "edition_verse_id": "BSB:PSA.116.18",
      "verse": 18,
      "spans": [
        {
          "text": "I will fulfill my vows to the LORD in the presence of all His people,",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.116.19",
      "edition_verse_id": "BSB:PSA.116.19",
      "verse": 19,
      "spans": [
        {
          "text": "in the courts of the LORD’s house, in your midst, O Jerusalem. Hallelujah!",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
