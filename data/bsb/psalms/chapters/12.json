{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 12,
  "verses": [
    {
      "id": "PSA.12.1",
      "edition_verse_id": "BSB:PSA.12.1",
      "verse": 1,
      "spans": [
        {
          "text": "For the choirmaster. According to Sheminith. A Psalm of David. Help, O LORD, for the godly are no more; the faithful have vanished from among men.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.12.2",
      "edition_verse_id": "BSB:PSA.12.2",
      "verse": 2,
      "spans": [
        {
          "text": "They lie to one another; they speak with flattering lips and a double heart.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.12.3",
      "edition_verse_id": "BSB:PSA.12.3",
      "verse": 3,
      "spans": [
        {
          "text": "May the LORD cut off all flattering lips and every boastful tongue.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.12.4",
      "edition_verse_id": "BSB:PSA.12.4",
      "verse": 4,
      "spans": [
        {
          "text": "They say, “With our tongues we will prevail. We own our lips— who can be our master?”",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.12.5",
      "edition_verse_id": "BSB:PSA.12.5",
      "verse": 5,
      "spans": [
        {
          "text": "“For the cause of the oppressed and for the groaning of the needy, I will now arise,” says the LORD. “I will bring safety to him who yearns.”",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.12.6",
      "edition_verse_id": "BSB:PSA.12.6",
      "verse": 6,
      "spans": [
        {
          "text": "The words of the LORD are flawless, like silver refined in a furnace, like gold purified sevenfold.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.12.7",
      "edition_verse_id": "BSB:PSA.12.7",
      "verse": 7,
      "spans": [
        {
          "text": "You, O LORD, will keep us; You will forever guard us from this generation.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.12.8",
      "edition_verse_id": "BSB:PSA.12.8",
      "verse": 8,
      "spans": [
        {
          "text": "The wicked wander freely, and vileness is exalted among men.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
