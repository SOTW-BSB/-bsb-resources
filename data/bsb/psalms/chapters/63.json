{
  "schema_version": "1.0.0",
  "edition_id": "BSB",
  "book_code": "PSA",
  "chapter": 63,
  "verses": [
    {
      "id": "PSA.63.1",
      "edition_verse_id": "BSB:PSA.63.1",
      "verse": 1,
      "spans": [
        {
          "text": "A Psalm of David, when he was in the Wilderness of Judah. O God, You are my God. Earnestly I seek You; my soul thirsts for You. My body yearns for You in a dry and weary land without water.",
          "kind": "text"
        }
      ],
      "paragraph_start": true
    },
    {
      "id": "PSA.63.2",
      "edition_verse_id": "BSB:PSA.63.2",
      "verse": 2,
      "spans": [
        {
          "text": "So I have seen You in the sanctuary and beheld Your power and glory.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.3",
      "edition_verse_id": "BSB:PSA.63.3",
      "verse": 3,
      "spans": [
        {
          "text": "Because Your loving devotion is better than life, my lips will glorify You.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.4",
      "edition_verse_id": "BSB:PSA.63.4",
      "verse": 4,
      "spans": [
        {
          "text": "So I will bless You as long as I live; in Your name I will lift my hands.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.5",
      "edition_verse_id": "BSB:PSA.63.5",
      "verse": 5,
      "spans": [
        {
          "text": "My soul is satisfied as with the richest of foods; with joyful lips my mouth will praise You.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.6",
      "edition_verse_id": "BSB:PSA.63.6",
      "verse": 6,
      "spans": [
        {
          "text": "When I remember You on my bed, I think of You through the watches of the night.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.7",
      "edition_verse_id": "BSB:PSA.63.7",
      "verse": 7,
      "spans": [
        {
          "text": "For You are my help; I will sing for joy in the shadow of Your wings.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.8",
      "edition_verse_id": "BSB:PSA.63.8",
      "verse": 8,
      "spans": [
        {
          "text": "My soul clings to You; Your right hand upholds me.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.9",
      "edition_verse_id": "BSB:PSA.63.9",
      "verse": 9,
      "spans": [
        {
          "text": "But those who seek my life to destroy it will go into the depths of the earth.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.10",
      "edition_verse_id": "BSB:PSA.63.10",
      "verse": 10,
      "spans": [
        {
          "text": "They will fall to the power of the sword; they will become a portion for foxes.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    },
    {
      "id": "PSA.63.11",
      "edition_verse_id": "BSB:PSA.63.11",
      "verse": 11,
      "spans": [
        {
          "text": "But the king will rejoice in God; all who swear by Him will exult, for the mouths of liars will be shut.",
          "kind": "text"
        }
      ],
      "paragraph_start": false
    }
  ]
}
